FHIR_BASE_URL=https://your-medblocks-fhir-server-base-url
FHIR_BEARER_TOKEN=your-private-token
FHIR_ACCESS_TOKEN=your-private-token-for-data-migration-scripts

# Demonstration authentication only — a public one-click synthetic demo session signed
# with this secret. Not production-grade identity management.
APP_SESSION_SECRET=generate-a-long-random-secret

# Public base URL used to build the SMART redirect URI.
APP_BASE_URL=https://waypoint-3dc6.onrender.com

# SMART App Launch client IDs. Register the callback URL below with each EHR:
# https://waypoint-3dc6.onrender.com/smart/callback
EPIC_CLIENT_ID=your-epic-nonproduction-client-id
ORACLE_CLIENT_ID=your-oracle-health-client-id

# Optional fallback client ID for a generic SMART sandbox.
SMART_CLIENT_ID=your-generic-smart-client-id

# Optional issuer allowlist for production. Comma-separate exact FHIR base URLs.
# Example: https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4,https://fhir-myrecord.cerner.com/r4/...
SMART_ALLOWED_ISSUERS=

# Override only when the registered EHR scopes differ from Waypoint's defaults.
# SMART_SCOPES=launch openid fhirUser patient/Patient.r patient/Condition.rs patient/Observation.rs patient/Encounter.rs patient/MedicationRequest.rs patient/ServiceRequest.rs
